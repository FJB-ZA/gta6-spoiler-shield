{
  "manifest_version": 3,
  "name": "GTA VI Spoiler Shield",
  "short_name": "Spoiler Shield",
  "version": "1.1.0",
  "description": "Keeps GTA VI spoilers off your screen: posts, videos, thumbnails, tags, tab titles and whole pages, wherever you browse.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "GTA VI Spoiler Shield",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "permissions": ["storage", "contextMenus", "webNavigation"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/patterns.js", "src/hanger.js", "src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    }
  ],
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    {
      "resources": ["blocked/*", "icons/*", "fonts/*", "src/content.css"],
      "matches": ["<all_urls>"]
    }
  ],
  "commands": {
    "toggle-shield": {
      "suggested_key": { "default": "Alt+Shift+G" },
      "description": "Turn the spoiler shield on or off"
    }
  },
  "minimum_chrome_version": "116"
}
